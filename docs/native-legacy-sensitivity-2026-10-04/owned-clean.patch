+            .output()
+            .unwrap();
+        let error = String::from_utf8_lossy(&output.stderr);
+        assert!(output.status.success(), "{mode}: {error}");
+        assert!(error.contains("frontend: native"), "{error}");
+        assert!(!output.stdout.is_empty());
+    }
+    std::fs::remove_file(path).unwrap();
