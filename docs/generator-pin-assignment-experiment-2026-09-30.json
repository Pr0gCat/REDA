  "prototype_source": "use reda::compile::topology::GateKind;\nuse reda::compile::{CompiledCircuit, Netlist, PlannerKind};\n\n// Experimental transformation of a cloned physical netlist. The source\n// artifact is unchanged; each printed permutation maps physical port to the\n// original logical input. All verification uses the transformed netlist.\npub fn assign(netlist: &mut Netlist, seed: &CompiledCircuit) {\n    if seed.planner_kind() != PlannerKind::Legacy { return; }\n    for gate in &mut netlist.gates {\n        if !matches!(gate.kind, GateKind::Nor(2..=3) | GateKind::Or(2..=3)) {continue;}\n        let n = gate.inputs.len();\n        let permutations = if n == 2 {\n            vec![vec![0,1], vec![1,0]]\n        } else {\n            vec![vec![0,1,2],vec![0,2,1],vec![1,0,2],vec![1,2,0],vec![2,0,1],vec![2,1,0]]\n        };\n        let cx = seed.gate_output_positions[&gate.output].0;\n        // Current channel emitter approach columns: west, east, centre.\n        let offsets = [-4,4,0];\n        let score = |permutation: &Vec<usize>| {\n            let spans: Vec<_> = permutation.iter().enumerate().map(|(port,&input)| {\n                let source = &gate.inputs[input];\n                let x = seed.gate_output_positions.get(source)\n                    .or_else(|| seed.input_positions.get(source)).unwrap().0;\n                (x - (cx + offsets[port])).abs()\n            }).collect();\n            (*spans.iter().max().unwrap(), spans.iter().sum::<i32>())\n        };\n        let identity = &permutations[0];\n        let best = permutations.iter().min_by_key(|p| score(p)).unwrap();\n        if score(best) < score(identity) {\n            let original = gate.inputs.clone();\n            gate.inputs = best.iter().map(|&i| original[i].clone()).collect();\n            eprintln!(\"PIN_ASSIGN {} physical_to_logical={best:?} original={original:?} assigned={:?}\",gate.output,gate.inputs);\n        }\n    }\n}\n",
