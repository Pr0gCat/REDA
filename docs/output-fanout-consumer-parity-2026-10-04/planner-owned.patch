+/// Per-input arrival contracts shared by placement and route requests.
+/// An observed input net keeps its diode isolation instead of a weak runway.
+pub(crate) fn arrival_runway_inputs(netlist: &Netlist) -> std::collections::HashSet<(usize, usize)> {
+    let selected = arrival_balance_gates(netlist).unwrap_or_default();
+    selected.into_iter().filter(|&gate| {
+        matches!(netlist.gates[gate].kind, crate::compile::topology::GateKind::Nor(n) if n > 0)
+    }).flat_map(|gate| {
+        netlist.gates[gate].inputs.iter().enumerate().filter_map(move |(input, signal)| {
+            (!netlist.outputs.contains(signal)).then_some((gate, input))
+        })
+    }).collect()
 }
 
