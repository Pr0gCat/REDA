+    #[test]
+    fn observed_inputs_reserve_no_unused_retiming_runway() {
+        let source = Netlist {
+            inputs: vec!["a".into(), "b".into()],
+            outputs: vec!["na".into(), "y".into()],
+            gates: vec![Gate::nor("na", &["a"]), Gate::nor("y", &["na", "b"])],
+        };
+        let graph = built(&source);
+        let body = &graph.bodies[graph.anchor_body[1]];
+        let cells = cells_for_graph(&graph, body);
+        let relay_cells = |input| {
+            let at = Position::new(0, 0, 0).offset(geometry::input_directions(body.facing)[input]);
+            [(at.x * 3, at.y, at.z * 3), (at.x * 2, at.y - 1, at.z * 2)]
+        };
+        for offset in relay_cells(0) {
+            assert!(!cells.iter().any(|cell| cell.offset == offset), "observed `na` keeps its diode rather than a retiming relay");
+        }
+        for offset in relay_cells(1) {
+            assert!(cells.iter().any(|cell| cell.offset == offset), "unobserved `b` retains the qualified relay runway");
         }
