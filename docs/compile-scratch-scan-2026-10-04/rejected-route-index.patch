+/// Keep first-write order while indexing the long shared route prefixes.
+/// A repeated coordinate still has to record exactly the same block state.
+#[derive(Default)]
+struct RecordedBlocks {
+    blocks: Vec<PlacedBlock>,
+    positions: BTreeMap<Anchor, usize>,
+}
+
+impl RecordedBlocks {
+    fn push(&mut self, at: Anchor, state: BlockState) -> Result<(), LegacyAdapterError> {
+        if let Some(&index) = self.positions.get(&at) {
+            check_recorded_state(at, &self.blocks[index].state, &state)?;
+        } else {
+            self.positions.insert(at, self.blocks.len());
+            self.blocks.push(PlacedBlock { at, state });
+        }
+        Ok(())
+    }
+}
+
+fn check_recorded_state(
+    at: Anchor,
+    existing: &BlockState,
+    state: &BlockState,
+) -> Result<(), LegacyAdapterError> {
+    if existing != state {
+        return Err(LegacyAdapterError::MalformedRoute {
+            route: format!("conflicting reconstructed block at {at:?}"),
+        });
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod recorded_blocks_tests {
+    use super::*;
+
+    #[test]
+    fn indexed_shared_prefix_preserves_order_states_and_conflict_refusal() {
+        let mut indexed = RecordedBlocks::default();
+        let mut original = Vec::new();
+        // Revisit overlapping prefixes in both directions, including states
+        // whose delay/power fields differ at different coordinates.
+        for end in [37, 9, 64, 37, 64] {
+            for x in (0..end).rev() {
+                let at = Anchor { x, y: 3, z: 7 };
+                let mut state = BlockState::air();
+                state.kind = BlockKind::Repeater;
+                state.delay = 1 + (x % 4) as u8;
+                indexed.push(at, state.clone()).unwrap();
+                push_block_once(&mut original, at, state).unwrap();
+            }
+        }
+        assert_eq!(indexed.blocks, original);
+        assert_eq!(indexed.blocks.len(), 64);
+        assert_eq!(indexed.blocks[0].at.x, 36);
+        let at = indexed.blocks[0].at;
+        let mut conflicting = indexed.blocks[0].state.clone();
+        conflicting.delay = 4;
+        let before = indexed.blocks.clone();
+        assert_eq!(
+            indexed.push(at, conflicting.clone()).unwrap_err().to_string(),
+            push_block_once(&mut original, at, conflicting).unwrap_err().to_string(),
+        );
+        assert_eq!(indexed.blocks, before);
+        indexed.push(at, before[0].state.clone()).unwrap();
+        assert_eq!(indexed.blocks, before);
+    }
+}
