+/// Owned experiment evidence: every source public occurrence and every actual gate.
+pub fn experiment_history(source:&Netlist,circuit:&CompiledCircuit)->Option<serde_json::Value> {
+    let phases=strict_profile(source,circuit,None)?;
+    Some(serde_json::json!(phases.iter().map(|p|serde_json::json!({"ticks":p.ticks,"queue_work":p.work,"physical_site_events":p.cells,"channels":p.channels})).collect::<Vec<_>>()))
+}
+
+fn literal_site_truths(source:&Netlist,circuit:&CompiledCircuit)->Option<Vec<Vec<bool>>> {
+    let implemented=circuit.implementation_netlist(source);let order=implemented.combinational_order()?;
+    let names=circuit.physical_rewrite()?.rewrite_certificate().rewritten_inputs_in_source_order();
+    let mut tables=vec![Vec::new();implemented.gates.len()];
+    for address in 0..1usize<<source.inputs.len() {
+        let v=values(implemented,&order,names.iter().enumerate().map(|(bit,n)|(n.as_str(),address&(1<<bit)!=0)))?;
+        for (i,g) in implemented.gates.iter().enumerate(){tables[i].push(v[g.output.as_str()]);}
+    }
+    Some(tables)
+}
+
+fn literal_profiles_dominate(source:&Netlist,baseline:&CompiledCircuit,candidate:&CompiledCircuit,old:&[StrictPhase],new:&[StrictPhase])->bool {
+    let Some(old_truth)=literal_site_truths(source,baseline) else{return false;};
+    let Some(new_truth)=literal_site_truths(source,candidate) else{return false;};
+    let offset=2*source.outputs.len();
+    let matches:Vec<Vec<usize>>=new_truth.iter().map(|table|old_truth.iter().enumerate().filter(|(_,old)|*old==table).map(|(i,_)|i).collect()).collect();
+    if matches.iter().any(Vec::is_empty)||old.len()!=new.len(){return false;}
+    let private=|phase:&StrictPhase|{
+        let channels=&phase.channels[offset..];
+        [channels.iter().map(|c|c[0]).sum::<u64>(),channels.iter().map(|c|c[1]).sum::<u64>(),channels.iter().map(|c|c[2]).max().unwrap_or(0),channels.iter().map(|c|c[3]).sum::<u64>(),channels.iter().map(|c|c[4]).max().unwrap_or(0)]
+    };
+    old.iter().zip(new).all(|(a,b)|{
+        b.ticks<=a.ticks&&b.work<=a.work&&b.cells<=a.cells
+        &&a.channels[..offset].iter().zip(&b.channels[..offset]).all(|(a,b)|a.iter().zip(b).all(|(a,b)|b<=a))
+        &&private(a).iter().zip(private(b)).all(|(a,b)|b<=*a)
+        &&matches.iter().enumerate().all(|(gate,old_gates)|old_gates.iter().all(|&old|b.channels[offset+gate].iter().zip(a.channels[offset+old]).all(|(b,a)|*b<=a)))
+    })&&old.iter().zip(new).any(|(a,b)|b.ticks<a.ticks||b.work<a.work||b.cells<a.cells||private(b)!=private(a))
+}
+
+/// Isolated prototype. Count generated proposals, retain budget-zero baseline.
+pub fn experiment_literal_selection(source:&Netlist,budget:usize)->Result<(CompiledCircuit,usize),CompileError> {
+    let baseline=compile_selected_with_refresh_budget(source,0)?;
+    if budget==0{return Ok((baseline,0));}
+    let rewrite=match super::fragment_synth::torch_row::compile_direct_literals(source,1_000_000) {
+        Ok(rewrite)=>rewrite,
+        Err(super::fragment_synth::torch_row::TorchRowError::UnsupportedBoundary)=>return Ok((baseline,0)),
+        Err(_)=>return Ok((baseline,1)),
+    };
+    let candidate=CompiledCircuit::from_certified_rewrite(rewrite);
+    let Some(old)=strict_profile(source,&baseline,None) else{return Ok((baseline,1));};
+    let Some(new)=strict_profile(source,&candidate,None) else{return Ok((baseline,1));};
+    Ok((if literal_profiles_dominate(source,&baseline,&candidate,&old,&new){candidate}else{baseline},1))
+}
