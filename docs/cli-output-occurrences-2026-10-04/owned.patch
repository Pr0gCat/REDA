+fn output_pinout<'a>(
+    compiled: &'a CompiledCircuit,
+    labels: &'a [(String, String)],
+) -> Result<Vec<(&'a str, &'a str, (i32, i32, i32))>, String> {
+    let mut remaining: Vec<_> = labels.iter().collect();
+    let mut entries = Vec::new();
+    for (signal, position) in compiled.output_occurrences() {
+        let index = remaining.iter().position(|(_, driver)| driver == signal)
+            .ok_or_else(|| format!("output occurrence {signal:?} has no public label"))?;
+        let (label, _) = remaining.remove(index);
+        entries.push((label.as_str(), signal.as_str(), *position));
+    }
+    if !remaining.is_empty() {
+        return Err("public output labels have no physical occurrences".into());
+    }
+    Ok(entries)
+}
