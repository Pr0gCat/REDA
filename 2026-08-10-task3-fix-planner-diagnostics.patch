+/// Compile a realisable netlist through the unified 3D planner.
+///
+/// The old row/channel/track implementation creates one legal seed only.
+/// The selected candidate is the sole source of the returned world.  Until
+/// the planner gains a block-level realiser for moved candidates, those
+/// candidates are rejected explicitly and the legal seed is selected.
+pub fn compile(netlist: &Netlist) -> Result<CompiledCircuit, CompileError> {
+    let legacy_seed = compile_legacy_seed(netlist)?;
+    let seed = planner::seed_from_legacy(netlist, &legacy_seed).map_err(planner_compile_error)?;
+    let report = planner::optimise_with_report(
+        seed.clone(),
+        planner::PlannerWeights::default(),
+        planner::PlannerEffort {
+            // A moved candidate is deliberately not emitted until the
+            // block-level realiser exists.  Probe one deterministic proposal
+            // so diagnostics exercise that rejection path without paying for
+            // a search whose results cannot yet become Worlds.
+            evaluations: 1,
+            seed: 0x26_02,
+        },
+    );
+
+    let (emission, rejected_unrealisable_candidates, selected_legacy_seed) =
+        match planner::realise_candidate(&report.candidate) {
+            Ok(emission) => (emission, 0, report.candidate != seed),
+            Err(planner::PlannerError::CandidateNotRealisable { .. }) => (
+                planner::realise_candidate(&seed).map_err(planner_compile_error)?,
+                1,
+                true,
+            ),
+            Err(error) => return Err(planner_compile_error(error)),
+        };
+
+    verify_legacy_emission(&emission)?;
+    Ok(compiled_from_legacy_emission(
+        emission,
+        PlannerDiagnostics {
+            kind: PlannerKind::Unified3d,
+            evaluated_candidates: report.evaluations,
+            rejected_unrealisable_candidates,
+            selected_legacy_seed,
+        },
+    ))
+}
+
+fn planner_compile_error(error: planner::PlannerError) -> CompileError {
+    CompileError::CandidateMetadataViolation {
+        item: "unified-3d-planner".to_string(),
+        reason: error.to_string(),
+    }
+}
